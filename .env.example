# Used by docker-compose.prod.yml. Copy to .env next to the compose file.
# Application secrets (SECRET_KEY, ENCRYPTION_KEY) live in backend/.env.

POSTGRES_USER=postgres
# Required. If the database volume already exists, use its current password.
POSTGRES_PASSWORD=
POSTGRES_DB=openlogbook

# Required for docker-compose.https.yml: public domain pointing at this server.
DOMAIN=
