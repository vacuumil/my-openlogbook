# Copy to backend/.env. Generate each secret with: openssl rand -hex 32
# In production the backend refuses to start until both keys are set.

ENVIRONMENT=development

# Signs JWT session tokens
SECRET_KEY=

# AES-256-GCM key for personal fields. Losing it makes that data unreadable: back it up.
ENCRYPTION_KEY=

# Previous key, only while running scripts/rotate_encryption_key.py
OLD_ENCRYPTION_KEY=

# Comma-separated origins. Not needed when nginx serves the app and API from one origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Leave empty for local SQLite
# DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@postgres:5432/logbook
